#!/bin/sh
# Read status directly from the current device; report unavailable values rather than guessing.
set -eu

battery=unavailable
for capacity in /sys/class/power_supply/*/capacity; do
    [ -r "$capacity" ] || continue
    value=$(cat "$capacity" 2>/dev/null || true)
    case $value in
        ''|*[!0-9]*) continue ;;
    esac
    battery="${value}%"
    break
done

network=
network_address=
for interface in usb0 wlan0; do
    state_file="/sys/class/net/$interface/operstate"
    [ -r "$state_file" ] || continue
    state=$(cat "$state_file" 2>/dev/null || true)
    [ "$state" = up ] || continue
    if [ "$interface" = usb0 ]; then
        network="${network:+$network · }USB"
    else
        network="${network:+$network · }Wi-Fi"
    fi
    address=$(ip -4 -o addr show dev "$interface" 2>/dev/null | awk 'NR == 1 { sub(/\/.*/, "", $4); print $4; exit }')
    [ -z "$address" ] || network_address="${network_address:+$network_address · }$address"
done
[ -n "$network" ] || network=offline
printf 'battery=%s\nnetwork=%s\naddress=%s\n' "$battery" "$network" "${network_address:-unavailable}"
