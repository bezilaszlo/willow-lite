#!/bin/sh
# Set a bounded backlight brightness for Control Center; lock dim/restore has its own helper.
set -eu

backlight=/sys/class/backlight/ktd3136-backlight
brightness=$backlight/brightness
maximum=$backlight/max_brightness
value=${1:-}

case $value in
    ''|*[!0-9]*) echo 'usage: willow-brightness INTEGER' >&2; exit 2 ;;
esac
[ -r "$maximum" ] && [ -r "$brightness" ] || { echo 'willow-brightness: backlight unavailable' >&2; exit 1; }
max=$(cat "$maximum")
case $max in ''|*[!0-9]*) echo 'willow-brightness: invalid maximum' >&2; exit 1 ;; esac
[ "$value" -le "$max" ] || { echo 'willow-brightness: value exceeds maximum' >&2; exit 2; }
printf '%s\n' "$value" | sudo -n /usr/bin/tee "$brightness" >/dev/null
actual=$(cat "$brightness")
[ "$actual" = "$value" ] || { echo 'willow-brightness: readback mismatch' >&2; exit 1; }
printf 'brightness=%s max=%s\n' "$actual" "$max"
