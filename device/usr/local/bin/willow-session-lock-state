#!/bin/sh
set -eu

runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
marker=$runtime_dir/willow-session-locked

[ -d "$runtime_dir" ] || {
    echo "runtime directory unavailable: $runtime_dir" >&2
    exit 1
}

case ${1:-} in
    locked)
        temp=$marker.$$
        trap 'rm -f "$temp"' EXIT HUP INT TERM
        umask 077
        : > "$temp"
        mv -f -- "$temp" "$marker"
        ;;
    unlocked)
        rm -f -- "$marker"
        ;;
    status)
        if [ -e "$marker" ]; then
            echo locked
            exit 0
        fi
        echo unlocked
        exit 1
        ;;
    *)
        echo 'usage: willow-session-lock-state locked|unlocked|status' >&2
        exit 2
        ;;
esac
