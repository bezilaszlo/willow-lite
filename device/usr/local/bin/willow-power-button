#!/bin/sh
# Stream PMIC power-key edges while holding logind's default power-key action.
set -eu

event=/dev/input/by-path/platform-1c40000.spmi-platform-1c40000.spmi:pmic@0:pon@800:pwrkey-event
parent=$PPID
[ -r "$event" ] || { echo unavailable; exit 1; }

systemd-inhibit --what=handle-power-key --who='Willow Lite' \
    --why='Willow Lite handles the physical power key' --mode=block \
    sh -c 'stdbuf -oL od -An -v -tu2 -w24 "$1" | awk '\''
        NF == 12 && $9 == 1 && $10 == 116 {
            value = $11 + $12 * 65536
            if (value == 1) print "down"; else if (value == 0) print "up"
            fflush()
        }
    '\''' sh "$event" &
inhibitor=$!

cleanup() {
    stop_tree() {
        for child in $(pgrep -P "$1" 2>/dev/null || true); do
            stop_tree "$child"
        done
        kill "$1" 2>/dev/null || true
    }
    stop_tree "$inhibitor"
    wait "$inhibitor" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 0' HUP INT TERM

ready=false
attempt=0
while [ "$attempt" -lt 20 ]; do
    kill -0 "$inhibitor" 2>/dev/null || exit 1
    if systemd-inhibit --list 2>/dev/null | grep -Fq 'Willow Lite'; then
        ready=true
        break
    fi
    attempt=$((attempt + 1))
    sleep 0.1
done
[ "$ready" = true ] || { echo unavailable; exit 1; }
printf 'ready\n'

# Quickshell owns this process. Drop the inhibitor if Quickshell exits or reloads.
while kill -0 "$parent" 2>/dev/null; do
    kill -0 "$inhibitor" 2>/dev/null || exit 1
    sleep 0.25
done
