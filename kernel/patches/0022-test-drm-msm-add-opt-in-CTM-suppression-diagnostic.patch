From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bezilaszlo <bezilaszlo95@gmail.com>
Date: Thu, 1 Oct 2026 09:10:59 +0200
Subject: test(drm/msm): add opt-in CTM suppression diagnostic

---
 drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
index 42d0a529b..6b6c44fef 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
@@ -11,6 +11,7 @@
 #include <linux/debugfs.h>
 #include <linux/ktime.h>
 #include <linux/bits.h>
+#include <linux/moduleparam.h>
 
 #include <drm/drm_atomic.h>
 #include <drm/drm_blend.h>
@@ -41,6 +42,10 @@
 /* timeout in ms waiting for frame done */
 #define DPU_CRTC_FRAME_DONE_TIMEOUT_MS	60
 
+static bool no_ctm;
+module_param_named(no_ctm, no_ctm, bool, 0444);
+MODULE_PARM_DESC(no_ctm, "Disable DPU CRTC CTM property for diagnostic testing");
+
 #define	CONVERT_S3_15(val) \
 	(((((u64)val) & ~BIT_ULL(63)) >> 17) & GENMASK_ULL(17, 0))
 
@@ -1917,9 +1922,10 @@ struct drm_crtc *dpu_crtc_init(struct drm_device *dev, struct drm_plane *plane,
 
 		if (dspp->sblk->gc.base) {
 			drm_mode_crtc_set_gamma_size(crtc, DPU_GAMMA_LUT_SIZE);
-			drm_crtc_enable_color_mgmt(crtc, 0, true, DPU_GAMMA_LUT_SIZE);
+			drm_crtc_enable_color_mgmt(crtc, 0, !no_ctm,
+					  DPU_GAMMA_LUT_SIZE);
 		} else {
-			drm_crtc_enable_color_mgmt(crtc, 0, true, 0);
+			drm_crtc_enable_color_mgmt(crtc, 0, !no_ctm, 0);
 		}
 	}
 
