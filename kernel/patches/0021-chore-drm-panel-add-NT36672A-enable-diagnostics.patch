From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bezilaszlo <bezilaszlo95@gmail.com>
Date: Wed, 30 Sep 2026 22:07:05 +0200
Subject: chore(drm/panel): add NT36672A enable diagnostics

Log an active DCS GET_POWER_MODE transaction after display-on and report accumulated display-on errors. This is diagnostic only; intermittent black graphical startup remains unresolved.
---
 drivers/gpu/drm/panel/panel-novatek-nt36672a.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36672a.c b/drivers/gpu/drm/panel/panel-novatek-nt36672a.c
index e16e4088b..a32716de4 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36672a.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36672a.c
@@ -179,12 +179,27 @@ static int nt36672a_panel_enable(struct drm_panel *panel)
 {
 	struct nt36672a_panel *pinfo = to_nt36672a_panel(panel);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->link };
+	u8 power_mode;
+	int ret;
 
 	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
 
 	/* Frame settling delay */
 	msleep(20);
 
+	if (dsi_ctx.accum_err < 0) {
+		dev_warn(panel->dev, "display-on command failed: %d\n",
+			 dsi_ctx.accum_err);
+		return dsi_ctx.accum_err;
+	}
+
+	ret = mipi_dsi_dcs_get_power_mode(pinfo->link, &power_mode);
+	if (ret)
+		dev_warn(panel->dev, "DCS power-mode read failed: %d\n", ret);
+	else
+		dev_info(panel->dev, "DCS power-mode status: %#04x (expected %#04x)\n",
+			 power_mode, 0x9c);
+
 	return dsi_ctx.accum_err;
 }
 
