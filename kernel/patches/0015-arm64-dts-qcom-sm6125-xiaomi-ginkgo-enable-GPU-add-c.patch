From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bezilaszlo <bezilaszlo95@gmail.com>
Date: Tue, 29 Sep 2026 17:27:28 +0200
Subject: arm64: dts: qcom: sm6125-xiaomi-ginkgo: enable GPU, add carve-outs
 and touch firmware

Adds the zap shader firmware name, the mmc0 alias, the debug, lastlog and
0xffd40000 carve-outs of the community DT, and the EBBG touch firmware.
---
 .../dts/qcom/sm6125-xiaomi-ginkgo-common.dtsi | 30 +++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6125-xiaomi-ginkgo-common.dtsi b/arch/arm64/boot/dts/qcom/sm6125-xiaomi-ginkgo-common.dtsi
index b5fc1ade2..c89b560a9 100644
--- a/arch/arm64/boot/dts/qcom/sm6125-xiaomi-ginkgo-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6125-xiaomi-ginkgo-common.dtsi
@@ -29,6 +29,7 @@ / {
 	qcom,board-id = <34 0>, <34 1>, <34 2>, <34 3>, <34 4>, <0 0>;
 
 	aliases {
+		mmc0 = &sdhc_1;
 		serial0 = &uart4;
 	};
 
@@ -86,6 +87,26 @@ gpu_mem: gpu_mem@57515000 {
 			no-map;
 		};
 
+		debug@ffb00000 {
+			reg = <0x0 0xffb00000 0x0 0xc0000>;
+			no-map;
+		};
+
+		lastlog@ffbc0000 {
+			reg = <0x0 0xffbc0000 0x0 0x80000>;
+			no-map;
+		};
+
+		memory@ffd40000 {
+			reg = <0x0 0xffd40000 0x0 0x1000>;
+			no-map;
+		};
+
+		memory@89b01000 {
+			reg = <0x0 0x89b01000 0x0 0x200000>;
+			no-map;
+		};
+
 		framebuffer_mem: framebuffer@5c000000 {
 			reg = <0x0 0x5c000000 0x0 (2340 * 1080 * 4)>;
 			no-map;
@@ -339,6 +360,14 @@ &usb3 {
 	status = "okay";
 };
 
+&gpu {
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/sm6125/xiaomi/ginkgo/a610_zap.mdt";
+};
+
 &mdss {
 	status = "okay";
 };
@@ -404,6 +433,7 @@ touchscreen@0 {
 		pinctrl-0 = <&ts_int_active>;
 		pinctrl-names = "default";
 		panel = <&panel>;
+		firmware-name = "novatek_ts_ebbg_fw.bin";
 		touchscreen-size-x = <1080>;
 		touchscreen-size-y = <2340>;
 	};
